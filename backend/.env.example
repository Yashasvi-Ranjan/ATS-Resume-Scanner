# Server Configuration
PORT=5001
NODE_ENV=development

# Database Configuration (PostgreSQL with Prisma)
DATABASE_URL="postgresql://username:password@localhost:5432/cvats_dev?schema=public"

# Authentication & Security
JWT_SECRET="replace_with_a_secure_jwt_secret_key_at_least_32_characters"
JWT_EXPIRES_IN="1d"

# CORS Configuration
CORS_ORIGIN="http://localhost:3000"

# File Upload Configuration (Local storage for MVP)
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=10

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
# Per-user limit on expensive AI endpoints (window ms / max requests)
AI_RATE_LIMIT_WINDOW_MS=900000
AI_RATE_LIMIT_MAX=60

# --- AI / LLM (optional; without a key AI endpoints return 503 "not configured") ---
# Provider: groq | openai | openai-compatible (e.g. Ollama, LM Studio) | none
LLM_PROVIDER=groq
# For Groq (LLM_PROVIDER=groq) the default model is openai/gpt-oss-120b; alternative: llama-3.3-70b-versatile
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=your_api_key_here
# Groq base URL defaults to https://api.groq.com/openai/v1. Only needed for openai-compatible (e.g. http://localhost:11434/v1) or to override defaults
LLM_BASE_URL=
LLM_TIMEOUT_MS=60000
# Retries for transient errors only (timeouts, 429, 5xx, network). Hard cap: 3
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_DELAY_MS=500
LLM_MAX_OUTPUT_TOKENS=4096
# Max characters of untrusted text (resume/JD/answers) sent in one prompt
LLM_MAX_INPUT_CHARS=30000
LLM_TEMPERATURE=0
# Max simultaneous in-flight LLM requests (process-wide)
LLM_MAX_CONCURRENT=3
# Max callers waiting for an LLM slot before requests are rejected with 429
LLM_MAX_QUEUE=50

# --- Match score weights (non-negative; normalised automatically, need not sum to 1) ---
MATCH_WEIGHT_SKILLS=0.35
MATCH_WEIGHT_EXPERIENCE=0.25
MATCH_WEIGHT_KEYWORDS=0.15
MATCH_WEIGHT_EDUCATION=0.10
MATCH_WEIGHT_PROJECTS=0.15
